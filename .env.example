# Firebase Client Keys (Frontend)
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# Firebase Admin Service Account JSON (Backend only)
# IMPORTANT: Minify the JSON key into a single string line
FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "...", ...}'

# Klaviyo API keys (Backend only)
KLAVIYO_API_KEY="pk_..."
KLAVIYO_LIST_ID="..."

# Security (Backend only)
ADMIN_SECRET="a-very-long-random-password-here"

# Stripe API keys (Backend only)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

